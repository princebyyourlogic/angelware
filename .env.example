# Copy to .env (chmod 600) and fill in.

# IPv4 address players reach this host on (LAN IP for local tests, public IP on a VPS).
ANGELWARE_PUBLIC_IP=192.0.2.10
# Address to listen on; 0.0.0.0 for all interfaces.
ANGELWARE_BIND=0.0.0.0
# TCP auth/lobby + UDP STUN port (the game uses 3074) and the second STUN port.
ANGELWARE_PORT=3074
ANGELWARE_STUN_ALT_PORT=3075

# Connection modes: direct (introduce peers), relay (all peer traffic through
# this host), adaptive (direct first, relay offered after ANGELWARE_DIRECT_WINDOW s).
ANGELWARE_STUN_MODE=direct
# Experimental SvR peer-address rewriting when mode is relay or adaptive.
# Keep off until testing; both players must sign in again after enabling it.
ANGELWARE_SVR_RELAY_REWRITE=off
# Observe stock hosts' authenticated connection reports (adaptive + rewrite).
ANGELWARE_SVR_OBSERVER=off
# Call of Duty 2: Big Red One NAT service on UDP 2273/2274 (off to disable).
ANGELWARE_BRO=on
ANGELWARE_BRO_MODE=relay
# UDP ports handed out as relay endpoints (relay and adaptive modes).
ANGELWARE_RELAY_PORTS=20000-20199
ANGELWARE_RELAY_MAX_CLIENTS=64
ANGELWARE_DIRECT_WINDOW=1.0

POSTGRES_PASSWORD=change-me
# Localhost-only port PostgreSQL is published on for angelware.
ANGELWARE_PG_PORT=55433

# verify: logins need a registered account (keyed 0x0B reply).
# open:   any login is accepted (plaintext 0x11 reply, no password check).
ANGELWARE_AUTH_MODE=verify
# debug logs every lobby task with its payload.
ANGELWARE_LOG_LEVEL=info
